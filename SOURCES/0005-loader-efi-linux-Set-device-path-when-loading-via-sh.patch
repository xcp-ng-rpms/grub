--- a/grub-core/loader/efi/linux.c
+++ b/grub-core/loader/efi/linux.c
@@ -214,7 +214,24 @@ grub_arch_efi_linux_boot_image_dp (grub_addr_t addr, grub_size_t size, const cha
   grub_size_t args_len;
 
   image_handle = grub_efi_get_last_verified_image_handle ();
-  if (image_handle == NULL)
+  if (image_handle)
+    {
+      grub_efi_device_path_t *new_dp;
+
+      loaded_image = grub_efi_get_loaded_image (image_handle);
+      if (loaded_image == NULL)
+        {
+          grub_error (GRUB_ERR_BAD_FIRMWARE, "missing loaded_image proto");
+          goto unload;
+        }
+
+      new_dp = grub_efi_duplicate_device_path_pool(dp);
+      if (!new_dp)
+        goto unload;
+
+      loaded_image->file_path = new_dp;
+    }
+  else
     {
       status = grub_efi_load_image (0, grub_efi_image_handle,
 				    dp,
@@ -223,17 +240,18 @@ grub_arch_efi_linux_boot_image_dp (grub_addr_t addr, grub_size_t size, const cha
 	{
 	  return grub_error (GRUB_ERR_BAD_OS, "cannot load image");
 	}
+
+      loaded_image = grub_efi_get_loaded_image (image_handle);
+      if (loaded_image == NULL)
+        {
+          grub_error (GRUB_ERR_BAD_FIRMWARE, "missing loaded_image proto");
+          goto unload;
+        }
     }
 
   grub_dprintf ("linux", "linux command line: '%s'\n", args);
 
   /* Convert command line to UTF-16. */
-  loaded_image = grub_efi_get_loaded_image (image_handle);
-  if (loaded_image == NULL)
-    {
-      grub_error (GRUB_ERR_BAD_FIRMWARE, "missing loaded_image proto");
-      goto unload;
-    }
   args_len = grub_strlen (args);
   len = (args_len + 1) * sizeof (grub_efi_char16_t);
   loaded_image->load_options =
diff --git a/include/grub/efi/efi.h b/include/grub/efi/efi.h
index 8eab6f7768b0..16e19232bcb9 100644
--- a/include/grub/efi/efi.h
+++ b/include/grub/efi/efi.h
@@ -78,8 +78,12 @@ grub_efi_device_path_t *
 EXPORT_FUNC(grub_efi_get_device_path) (grub_efi_handle_t handle);
 grub_efi_device_path_t *
 EXPORT_FUNC(grub_efi_find_last_device_path) (const grub_efi_device_path_t *dp);
+grub_ssize_t
+EXPORT_FUNC(grub_efi_device_path_len) (const grub_efi_device_path_t *dp);
 grub_efi_device_path_t *
 EXPORT_FUNC(grub_efi_duplicate_device_path) (const grub_efi_device_path_t *dp);
+grub_efi_device_path_t *
+EXPORT_FUNC(grub_efi_duplicate_device_path_pool) (const grub_efi_device_path_t *dp);
 grub_err_t EXPORT_FUNC (grub_efi_finish_boot_services) (grub_efi_uintn_t *outbuf_size, void *outbuf,
 							grub_efi_uintn_t *map_key,
 							grub_efi_uintn_t *efi_desc_size,
