+	gf prod[255];
+
+	for (i = 0; i < 255; i++)
+		prod[i] = 0;
+
+	for (i = 0; i < 128; i++)
+		for (j = 0; j < 128; j++)
+			prod[i+j] ^= gf_mul(in0[i], in1[j]);
