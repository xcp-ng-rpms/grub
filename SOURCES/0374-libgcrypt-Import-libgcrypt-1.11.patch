+/* de-byteslice, apply post-whitening and store blocks */
+#define outunpack64(x0, x1, x2, x3, x4, x5, x6, x7, y0, y1, y2, y3, y4, \
+		    y5, y6, y7, key, tmp0, tmp1) \
+	byteslice_16x16b_fast(y0, y4, x0, x4, y1, y5, x1, x5, y2, y6, x2, x6, \
+			      y3, y7, x3, x7, tmp0, tmp1); \
+	\
+	vpbroadcastq key, tmp0; \
+	vpshufb .Lpack_bswap rRIP, tmp0, tmp0; \
+	\
+	vpxorq tmp0, y7, y7; \
+	vpxorq tmp0, y6, y6; \
+	vpxorq tmp0, y5, y5; \
+	vpxorq tmp0, y4, y4; \
+	vpxorq tmp0, y3, y3; \
+	vpxorq tmp0, y2, y2; \
+	vpxorq tmp0, y1, y1; \
+	vpxorq tmp0, y0, y0; \
+	vpxorq tmp0, x7, x7; \
+	vpxorq tmp0, x6, x6; \
+	vpxorq tmp0, x5, x5; \
+	vpxorq tmp0, x4, x4; \
+	vpxorq tmp0, x3, x3; \
+	vpxorq tmp0, x2, x2; \
+	vpxorq tmp0, x1, x1; \
+	vpxorq tmp0, x0, x0;
