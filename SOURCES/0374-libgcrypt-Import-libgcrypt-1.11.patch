new file mode 100644
index 0000000..de0a183
--- /dev/null
+++ b/grub-core/lib/libgcrypt/src/context.c
@@ -0,0 +1,154 @@
+/* context.c - Context management
+ * Copyright (C) 2013  g10 Code GmbH
+ *
