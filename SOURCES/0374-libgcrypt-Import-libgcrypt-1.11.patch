+	vmovdqu64	0*8(%rdi), A_0_0
+	vmovdqu64	1*8(%rdi), A_0_1
+	vmovdqu64	2*8(%rdi), A_0_2
+	vmovdqu64	3*8(%rdi), A_0_3
+	vmovdqu64	4*8(%rdi), A_0_4
