+#define aria_diff_m(x0, x1, x2, x3,			\
+		    t0, t1, t2, t3)			\
+	/* T = rotr32(X, 8); */				\
+	/* X ^= T */					\
+	/* X = T ^ rotr(X, 16); */			\
+	vmovdqa64 x0, t0;				\
+	vmovdqa64 x3, t3;				\
