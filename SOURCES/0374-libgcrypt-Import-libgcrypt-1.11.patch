+_gcry_serpent_neon_blk8:
+	/* input:
+	 *	r0: ctx, CTX
+	 *	r1: dst (8 blocks)
+	 *	r2: src (8 blocks)
+	 *	r3: encrypt
+	 */
+
+	push {lr};
+	vpush {RA4-RB2};
+
+	cmp r3, #0
+
+	vld1.8 {RA0, RA1}, [r2]!;
+	vld1.8 {RA2, RA3}, [r2]!;
+	vld1.8 {RB0, RB1}, [r2]!;
+	vld1.8 {RB2, RB3}, [r2]!;
+
+	beq .Lblk8_dec;
+		bl __serpent_enc_blk8;
+		vst1.8 {RA4}, [r1]!;
+		vst1.8 {RA1, RA2}, [r1]!;
+		vst1.8 {RA0}, [r1]!;
+		vst1.8 {RB4}, [r1]!;
+		vst1.8 {RB1, RB2}, [r1]!;
+		vst1.8 {RB0}, [r1]!;
+		b .Lblk8_end;
+	.Lblk8_dec:
+		bl __serpent_dec_blk8;
+		vst1.8 {RA0, RA1}, [r1]!;
+		vst1.8 {RA2, RA3}, [r1]!;
+		vst1.8 {RB0, RB1}, [r1]!;
+		vst1.8 {RB2, RB3}, [r1]!;
