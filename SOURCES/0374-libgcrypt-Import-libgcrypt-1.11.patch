+static inline unsigned int
+bulk_cbc_dec_128 (void *priv, bulk_crypt_fn_t crypt_fn, byte *outbuf,
+                  const byte *inbuf, size_t nblocks, byte *iv,
+                  byte *tmpbuf, size_t tmpbuf_nblocks,
+                  unsigned int *num_used_tmpblocks)
