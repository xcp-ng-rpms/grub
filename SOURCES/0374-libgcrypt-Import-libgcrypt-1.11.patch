+	vmovdqa32 S14, X14;
+	transpose_16byte_4x4(X3, X7, X11, X15, TMP0, TMP1);
+	xor_src_dst_4x4(DST, SRC, (64 * 3), 256, X3, X7, X11, X15);
+	leaq (16 * 64)(SRC), SRC;
