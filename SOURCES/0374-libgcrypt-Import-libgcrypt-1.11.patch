+	vmovdqu64 y2, 10 * 64(rio); \
+	vmovdqu64 y3, 11 * 64(rio); \
+	vmovdqu64 y4, 12 * 64(rio); \
+	vmovdqu64 y5, 13 * 64(rio); \
+	vmovdqu64 y6, 14 * 64(rio); \
+	vmovdqu64 y7, 15 * 64(rio);
