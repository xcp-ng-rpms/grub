+  return _gcry_aes_ocb_auth_armv8_ce (keysched, abuf, c->u_mode.ocb.aad_offset,
+				      c->u_mode.ocb.aad_sum, c->u_mode.ocb.L[0],
+				      nblocks, nrounds, (unsigned int)blkn);
+}
