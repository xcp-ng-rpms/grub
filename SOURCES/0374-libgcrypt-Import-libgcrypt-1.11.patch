+	for (i = 0; i < GFBITS; i++)
+	{
+		tmp = (e >> i) & 1;
+
+		in[0][i] = (in[0][i] >> 1) | (in[1][i] << 63);
+		in[1][i] = (in[1][i] >> 1) | (tmp      << 63);
+	}
