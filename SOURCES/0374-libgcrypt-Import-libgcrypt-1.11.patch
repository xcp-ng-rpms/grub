+
+.align	64, 0xcc
+.Loop_absorb_144_ce:
+	subq		%r8, %rcx	// len - bsz
+	jb		.Labsorbed_ce
+
+	vpxorq		0*8(%rdx), A_0_0, A_0_0
+	vpxorq		1*8(%rdx), A_0_1, A_0_1
+	vpxorq		2*8(%rdx), A_0_2, A_0_2
