+ELF(.type	_gcry_keccak_absorb_blocks_avx512,@function)
+.align	64, 0xcc
+_gcry_keccak_absorb_blocks_avx512:
+	/* input:
+	 *	%rdi: state
+	 *	%rsi: round constants
+	 *	%rdx: lanes
+	 *	%rcx: nlanes
