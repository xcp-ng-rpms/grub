+static inline gf vec_reduce(vec in[][GFBITS])
+{
+	int i;
+	vec tmp;
+	gf ret = 0;
+
+	for (i = GFBITS-1; i >= 0; i--)
+	{
+		tmp = in[0][i] ^ in[1][i];
