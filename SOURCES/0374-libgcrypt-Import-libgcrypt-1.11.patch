+	vec inv[ 128 ][ GFBITS ];
+	vec scaled[ 128 ][ GFBITS ];
+	vec eval[ 128 ][ GFBITS ];
+
+	vec error[ 128 ];
+
+	vec s_priv[ 4 ][ GFBITS ];
+	vec s_priv_cmp[ 4 ][ GFBITS ];
+	vec locator[2][ GFBITS ];
+
+	vec recv[ 128 ];
+	vec allone;
