+	vmovdqa32 S7, X7;
+	vpbroadcastd (11 * 4)(INPUT), X11;
+	vmovdqa32 S15, X15;
+
+	/* Update counter */
+	addq $16, (12 * 4)(INPUT);
+	jmp .Lround2_entry_16v;
+
+.align 16
+.Loop16v:
+	movl $20, ROUND;
+	subq $16, NBLKS;
