+	vmovdqu64 x1, 1 * 64(rio); \
+	vmovdqu64 x2, 2 * 64(rio); \
+	vmovdqu64 x3, 3 * 64(rio); \
+	vmovdqu64 x4, 4 * 64(rio); \
+	vmovdqu64 x5, 5 * 64(rio); \
+	vmovdqu64 x6, 6 * 64(rio); \
