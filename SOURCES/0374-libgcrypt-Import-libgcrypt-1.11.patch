+		tmp ^= tmp >> 32;
+		tmp ^= tmp >> 16;
+		tmp ^= tmp >> 8;
+		tmp ^= tmp >> 4;
+		tmp ^= tmp >> 2;
+		tmp ^= tmp >> 1;
+
+		ret <<= 1;
+		ret |= tmp & 1;
+	}
+
+	return ret;
