+.align 16
+.Lprocess_16v:
+	/* Process 16 ChaCha20 blocks */
+
+	/* Preload state to ZMM registers */
+	vpbroadcastd (0 * 4)(INPUT), S0;
+	vpbroadcastd (1 * 4)(INPUT), S1;
+	vpbroadcastd (2 * 4)(INPUT), S2;
+	vpbroadcastd (3 * 4)(INPUT), S3;
