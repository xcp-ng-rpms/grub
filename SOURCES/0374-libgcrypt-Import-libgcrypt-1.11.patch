+	uint64_t x = in;
+	uint64_t t;
+
+	x = (x | (x << 24)) & B[3];
+	x = (x | (x << 12)) & B[2];
+	x = (x | (x << 6)) & B[1];
+	x = (x | (x << 3)) & B[0];
