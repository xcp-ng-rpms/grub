+      i = 0;
+      while (i + 2 * p <= n)
+	{
+	  for (j = i; j < i + p; ++j)
+	    int32_MINMAX (x[j], x[j + p]);
+	  i += 2 * p;
+	}
+      for (j = i; j < n - p; ++j)
+	int32_MINMAX (x[j], x[j + p]);
+
+      i = 0;
+      j = 0;
+      for (q = top; q > p; q >>= 1)
+	{
+	  if (j != i)
+	    for (;;)
+	      {
+                int32_t a;
+
+		if (j == n - q)
+		  goto done;
+		a = x[j + p];
+		for (r = q; r > p; r >>= 1)
+		  int32_MINMAX (a, x[j + r]);
+		x[j + p] = a;
+		++j;
+		if (j == i + p)
+		  {
+		    i += 2 * p;
+		    break;
+		  }
+	      }
+	  while (i + p <= n - q)
+	    {
+	      for (j = i; j < i + p; ++j)
+		{
+		  int32_t a = x[j + p];
+		  for (r = q; r > p; r >>= 1)
+		    int32_MINMAX (a, x[j + r]);
+		  x[j + p] = a;
+		}
+	      i += 2 * p;
+	    }
+	  /* now i + p > n - q */
+	  j = i;
+	  while (j < n - q)
+	    {
+	      int32_t a = x[j + p];
+	      for (r = q; r > p; r >>= 1)
+		int32_MINMAX (a, x[j + r]);
+	      x[j + p] = a;
+	      ++j;
+	    }
