+  /* dw = subl(33) & subl(24), subr(33) ^= CAMELLIA_RL1(dw); */
+  vpand128(x15, x5, x14);
+  vpslld128(1, x14, x13);
+  vpsrld128(31, x14, x14);
+  vpaddb128(x13, x14, x14);
+  vpsrldq128(12, x14, x14);
+  vpslldq128(8, x14, x14);
+  vpxor128(x14, x15, x15);
