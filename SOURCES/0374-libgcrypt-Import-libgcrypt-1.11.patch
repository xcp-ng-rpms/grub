+					  const void *inbuf_arg,
+					  size_t nblocks,
+					  unsigned int nrounds);
+
+extern void _gcry_vaes_avx2_cfb_dec_i386 (const void *keysched,
+					  unsigned char *iv,
+					  void *outbuf_arg,
+					  const void *inbuf_arg,
+					  size_t nblocks,
+					  unsigned int nrounds);
+
