+
+	t = tmp & 0x1FF0000;
+	tmp ^= (t >> 9) ^ (t >> 10) ^ (t >> 12) ^ (t >> 13);
+
+	t = tmp & 0x000E000;
+	tmp ^= (t >> 9) ^ (t >> 10) ^ (t >> 12) ^ (t >> 13);
+
+	return tmp & GFMASK;
+}
