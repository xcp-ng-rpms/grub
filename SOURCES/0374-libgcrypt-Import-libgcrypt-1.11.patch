+static void scaling_inv(vec out[][GFBITS], vec inv[][GFBITS], vec *recv)
+{
+	int i, j;
+
+	for (i = 0; i < 128; i++)
+	for (j = 0; j < GFBITS; j++)
+		out[i][j] = inv[i][j] & recv[i];
